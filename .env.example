# Copy to backend/.env for running the backend outside Docker.
OPENFLEET_DATABASE_URL=postgresql+asyncpg://openfleet:openfleet@localhost:5433/openfleet
OPENFLEET_LOG_LEVEL=INFO

# Sign in with Google (DECISIONS #038). For docker compose, put these in .env at the repo root.
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web application),
# authorized redirect URI = OPENFLEET_OIDC_REDIRECT_URL.
# OPENFLEET_OIDC_CLIENT_ID=1234-abc.apps.googleusercontent.com
# OPENFLEET_OIDC_CLIENT_SECRET=GOCSPX-...
# OPENFLEET_OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
# Who may sign in without an invite (created as viewers). Invite others with
#   docker compose exec backend openfleet users create alice@example.com --sso [--role operator]
# OPENFLEET_OIDC_ALLOWED_DOMAINS=["example.com"]
