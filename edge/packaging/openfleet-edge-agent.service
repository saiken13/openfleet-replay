# systemd unit for the edge agent on a Linux robot computer.
#   install -m755 openfleet-edge-agent /usr/local/bin/
#   install -m644 openfleet-edge-agent.service /etc/systemd/system/
#   install -m600 /dev/null /etc/openfleet/edge-agent.env   # then add OPENFLEET_API_KEY=...
#   systemctl daemon-reload && systemctl enable --now openfleet-edge-agent
#
# Run under a real systemd boot by edge/qemu/qemu_e2e.py (Debian 13 arm64 in QEMU): start at
# boot, crash restart, stop, reboot and poweroff, and the hardening below
# (`systemd-analyze security`: 1.2; 3.4 without the second block, DECISIONS #036).
#
# Serial devices (--device serial:/dev/ttyUSB0): PrivateDevices hides /dev, so add a drop-in
#   [Service]
#   PrivateDevices=no
#   DeviceAllow=/dev/ttyUSB0 rw
#   SupplementaryGroups=dialout
[Unit]
Description=OpenFleet edge agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/openfleet/edge-agent.env
# Edit the robot id, API URL and watched processes for this machine.
ExecStart=/usr/local/bin/openfleet-edge-agent --robot-id=edge-01 --api=https://openfleet.example.com
# SIGTERM: flush buffered batches (<= 5 s), end the run ABORTED.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

# It only reads /proc and talks HTTP(S).
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=64M
# It reads /proc/stat, /proc/meminfo and /proc/<pid>/stat of every process (world-readable),
# so ProtectProc=invisible and ProcSubset=pid would break it; PrivateUsers doesn't.
PrivateUsers=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
